{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "RESEND_API_KEY",
        "CONTACT_TO_EMAIL",
        "CONTACT_FROM_EMAIL",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
        "GATES_ORG_ID",
        "GITHUB_TOKEN",
        "github_pat",
        "VERCEL_TOKEN",
        "vercel_pat",
        "VERCEL_TEAM_ID",
        "DATABASE_URL",
        "FLEET_ADMIN_USER_IDS",
        "FLEET_OPERATOR_USER_IDS",
        "FLEET_ACTIONS_ENABLED"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
