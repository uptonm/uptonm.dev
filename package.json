{
  "name": "turborepo-shadcn-tailwind-v4",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  },
  "trustedDependencies": [
    "sharp"
  ],
  "overrides": {
    "postcss": "^8.5.10"
  }
}
